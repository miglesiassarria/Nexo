{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexo",
  "version": "0.1.0",
  "identifier": "com.nexo.gateway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexo",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["icons/tray/*"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "Gateway local de IA",
    "longDescription": "Punto común de acceso a modelos de IA desde tus aplicaciones, con estadísticas locales de uso."
  }
}
