# Nexo escucha solo en localhost por defecto.
NEXO_HOST=127.0.0.1
NEXO_PORT=3000

# Si se define, las aplicaciones cliente deben enviar Authorization: Bearer <token>.
NEXO_API_TOKEN=

# Proveedor OpenAI oficial. No es la suscripción de ChatGPT.
OPENAI_API_KEY=

# Gemini API mediante OAuth de Google Cloud o mediante API key.
# El access token debe ser de corta duración y no debe commitearse.
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_GEMINI_API_KEY=

