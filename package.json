{
  "name": "nexo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "site:dev": "vite --config website/site.config.ts",
    "site:build": "vite build --config website/site.config.ts",
    "site:preview": "vite preview --config website/site.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "app:install": "bash scripts/install-macos.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^6"
  }
}
